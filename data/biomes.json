	"weathers": {
		"_doc": "How each kind of weather looks (see core/weather.gd). The real weather is one of sunny, partly, cloudy, rainy, stormy or snowy; a place's 'weather' rules can turn a kind into another (the tundra's blizzard) or into 'sunny' for none. clouds: how many cross the sky; overcast: 0..1, greying the sky and dimming the light and the sun; rain and snow: drops and flakes on a 720 x 720 screen; wind: how hard it blows them sideways; lightning: flashes and thunder; haze: a white-out.",
		"sunny":    {"name": "Sunny"},
		"partly":   {"name": "Sun and cloud", "clouds": 5, "overcast": 0.1},
		"cloudy":   {"name": "Cloudy", "clouds": 11, "overcast": 0.55},
		"rainy":    {"name": "Rain", "clouds": 12, "overcast": 0.65, "rain": 140, "wind": 0.2},
		"stormy":   {"name": "Storm", "clouds": 14, "overcast": 0.85, "rain": 280, "wind": 1.0, "lightning": true},
		"snowy":    {"name": "Snow", "clouds": 11, "overcast": 0.55, "snow": 160, "wind": 0.2},
		"blizzard": {"name": "Blizzard", "clouds": 14, "overcast": 0.75, "snow": 360, "wind": 1.8, "haze": 0.35}
	},
	"day_cycle": {
		"_doc": "Places without fixed_light follow the real clock. Each key is the sky and light at that hour (in order); in between they blend, round the clock. 'dark' (0 day .. 1 night) brings out the stars, fireflies and the night chorus. The sun is up from sunrise to sunset; the moon rises moon_gap hours after sunset and sets moon_gap hours before sunrise.",
		"sunrise": 6.0,
		"sunset": 18.0,
		"moon_gap": 0.5,
		"keys": [
			{"hour": 0.0,   "sky_top": "#121831", "sky_bottom": "#262c50", "tint": "#666c95", "dark": 1.0},
